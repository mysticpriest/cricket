# Development only. Set in the shell before running npm start.
# A new database requires these variables to create its first administrator.
# Optional friendly name for the first administrator account. You can later edit it from Staff accounts.
CRICKET_ADMIN_NAME=Administrator
CRICKET_ADMIN_EMAIL=admin@example.test
CRICKET_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LONG_PASSWORD
# Optional
PORT=3000
HOST=127.0.0.1
# For production behind an HTTPS proxy, configure PUBLIC_ORIGIN=https://your-domain.example
# and NODE_ENV=production. Do not expose this prototype to real patient data.

# Optional caller audio captions. Never commit real resource credentials.
# Microsoft Azure AI Speech resource key and its matching region (e.g. eastus).
# Required only to enable caption transcription; user must grant tab/system audio access.
CRICKET_AZURE_SPEECH_KEY=
CRICKET_AZURE_SPEECH_REGION=
