# Copy to .env in the repository ROOT; never commit the private .env.
# Configure DNS: staging domain A record points to VM public IP.
CRICKET_DOMAIN=demo.yourdomain.example
# All placeholders must be replaced by strong, distinct credentials.
# Existing database passwords are NOT reset by changing this file.
CRICKET_ADMIN_NAME=Demo Administrator
CRICKET_ADMIN_EMAIL=demo-admin@yourdomain.example
CRICKET_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_UNIQUE_PASSWORD
CRICKET_NEUTRAUMA_OFFICE_KEY=REPLACE_WITH_RANDOM_32_CHARACTER_OFFICE_KEY
CRICKET_PLATFORM_ADMIN_EMAIL=owner@yourdomain.example
CRICKET_PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_PASSWORD
CRICKET_PLATFORM_OFFICE_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_CHARACTER_KEY
